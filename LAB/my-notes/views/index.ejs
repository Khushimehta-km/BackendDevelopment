<!DOCTYPE html>
<html>
<head>
    <title>My Notes</title>
    <link rel="stylesheet" href="/style.css">
    
</head>

<body>

<h1>My Notes</h1>

<a href="/notes/new">Add New Note</a>

<% if (notes.length === 0) { %>

    <p>No notes available.</p>

<% } else { %>

    <% notes.forEach(note => { %>

        <div class="note">

            <h2><%= note.title %></h2>

            <p><%= note.content %></p>

            <p>Category: <%= note.category %></p>

            <p>Created: <%= note.createdAt %></p>

            <form action="/notes/<%= note._id %>/delete" method="POST">
                <button type="submit">Delete</button>
            </form>

        </div>

    <% }) %>

<% } %>

</body>
</html>